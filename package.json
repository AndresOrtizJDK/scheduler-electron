{
  "name": "scheduler-electron",
  "productName": "Scheduler",
  "description": "Captura procesos del sistema y los guarda como catálogos en la API de planificación.",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dist": "bun run build && electron-builder",
    "dist:win": "bun run build && electron-builder --win",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "systeminformation": "^5.33.16"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@eslint/js": "^10",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "lucide-react": "^1.59.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-plugin-electron": "^1.1.2"
  },
  "trustedDependencies": [
    "electron"
  ],
  "build": {
    "appId": "dev.salesconnect.scheduler",
    "productName": "Scheduler",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "extraFiles": [
      {
        "from": ".env.example",
        "to": ".env"
      }
    ],
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
